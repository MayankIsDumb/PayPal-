# ---------------------------------------------------------------------------
# CommishGuard AI — environment template
# Copy to `.env` (git-ignored) and fill in what you have.
# With no PayPal credentials the app runs in MOCK mode and stays fully demo-able.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=7070

# --- PayPal Sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ---
# IMPORTANT: these must be SANDBOX app credentials. Never use live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave unset to auto-detect (mock when credentials are absent).
# PAYPAL_MOCK=true
PAYPAL_RETURN_URL=http://localhost:7070/api/paypal/return
PAYPAL_CANCEL_URL=http://localhost:7070/api/paypal/cancel

# --- AI contract parser (any OpenAI-compatible endpoint) ---
# Without a key, the deterministic regex parser is used and the UI says so.
# AI_API_KEY is the preferred name; LLM_API_KEY is accepted as an alias.
AI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Uploads / storage ---
FILE_MAX_MB=50
STORAGE_DIR=storage

# --- Verification guardrails (defaults shown) ---
VERIFY_MAX_ENTRIES=5000
VERIFY_MAX_UNCOMPRESSED_MB=250
VERIFY_MAX_RATIO=200
VERIFY_MIN_RENDER_PIXELS=400
